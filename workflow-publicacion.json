    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fila de log.md + body del commit.\nconst cfg = $('Configuracion').first().json;\nconst em  = $('Emparejar post publicado').first().json;\nconst sel = $('Seleccionar post de hoy').first().json;\nconst post = em.post;\n\n// Este nodo se alcanza por dos caminos: con comentario publicado o sin él.\nlet comentarioOk = false, mediaId = em.mediaId || '—';\ntry {\n  const c = $('Meta: publicar comentario').first().json;\n  comentarioOk = Boolean(c && c.id);\n} catch (e) { /* rama sin comentario */ }\n\nlet contenido = sel.logContenido || '';\nconst sha = sel.logSha || '';\nif (!contenido.trim()) {\n  contenido = [\n    '# Log de publicaciones — PROMPTIO',\n    '',\n    'Registro automático del workflow de n8n (`workflow-publicacion.json`).',\n    'El workflow lee este archivo para no publicar dos veces el mismo post,',\n    'así que no borres filas salvo que quieras volver a publicar una pieza.',\n    '',\n    '| ID | Post | Publicado | Láminas | Media ID | Comentario |',\n    '|----|------|-----------|---------|----------|------------|',\n    ''\n  ].join('\\n');\n}\n\nconst fila = '| ' + [\n  post.id, post.titulo,\n  DateTime.now().setZone(cfg.zonaHoraria).toFormat('yyyy-MM-dd HH:mm'),\n  em.totalImagenes, mediaId,\n  comentarioOk ? 'sí' : 'NO'\n].join(' | ') + ' |';\n\nconst nuevo = contenido.trimEnd() + '\\n' + fila + '\\n';\nconst body = {\n  message: 'log: publicado ' + post.id + ' — ' + post.titulo + (comentarioOk ? '' : ' (sin comentario)'),\n  content: Buffer.from(nuevo, 'utf8').toString('base64'),\n  branch: cfg.branch\n};\nif (sha) body.sha = sha;\n\nreturn [{ json: { body, post, comentarioOk, mediaId, totalImagenes: em.totalImagenes } }];"
      },
