    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ $('Configuracion').first().json.renderizadorUrl }}/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.id, modo: $json.modoRender }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "renderizador-generar-carrusel",
      "name": "Renderizador: generar carrusel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_RENDER",
          "name": "Renderizador PROMPTIO"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "notes": "Chromium headless en el mismo VPS. Un carrusel tarda unos segundos; el timeout de 120 s cubre un arranque en frío."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// El renderizador responde 200 con las láminas, o 4xx con {error}. Con\n// onError=continueRegularOutput el nodo HTTP no corta la ejecución, así que\n// el fallo se traduce aquí a la rama de aviso.\nconst r = $input.first().json || {};\n\nif (r.error) {\n  return [{ json: { estado: 'error', etapa: 'render del carrusel', detalle: String(r.error) } }];\n}\n\nconst laminas = r.laminas || [];\nif (laminas.length < 2) {\n  return [{ json: { estado: 'error', etapa: 'render del carrusel',\n                    detalle: 'El renderizador devolvió ' + laminas.length + ' lámina(s). '\n                           + 'Un carrusel necesita al menos portada y cierre. Respuesta: '\n                           + JSON.stringify(r).slice(0, 400) } }];\n}\n\nconst ultima = laminas[laminas.length - 1];\nif (ultima.tipo !== 'cierre') {\n  return [{ json: { estado: 'error', etapa: 'render del carrusel',\n                    detalle: 'La última lámina es \"' + ultima.tipo + '\" y no el cierre de marca. '\n                           + 'No se publica un carrusel sin su lámina de cierre.' } }];\n}\n\nreturn [{ json: { estado: 'listo', urls: laminas.map(l => l.url), totalPaginas: laminas.length } }];"
      },
      "id": "evaluar-render",
      "name": "Evaluar render",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r0",
                    "leftValue": "={{ $json.estado }}",
                    "rightValue": "listo",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "listo"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.estado }}",
                    "rightValue": "error",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "error"
            }
          ]
        },
        "options": {}
      },
      "id": "estado-render",
      "name": "Estado render",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1740,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Una URL de lámina por item, para descargarlas y subirlas en orden.\nconst urls = $input.first().json.urls || [];\nreturn urls.map((url, i) => ({ json: { url, pagina: i + 1, total: urls.length } }));"
      },
      "id": "expandir-laminas",
      "name": "Expandir laminas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        200
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "descargar-lamina",
      "name": "Descargar lamina",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2180,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_RENDER",
          "name": "Renderizador PROMPTIO"
        }
      },
      "notes": "Sirve el PNG del propio renderizador. Misma credencial X-Token."
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ $('Configuracion').first().json.postizUrl }}/public/v1/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "id": "postiz-subir-lamina",
      "name": "Postiz: subir lamina",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3940,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_POSTIZ",
          "name": "Postiz API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Body de creación de post en Postiz. Publicación inmediata.\nconst cfg  = $('Configuracion').first().json;\nconst post = $('Verificar datos del guion').first().json;\n\nconst imagenes = $input.all().map(i => ({ id: i.json.id })).filter(x => x.id);\nif (imagenes.length === 0) throw new Error('Postiz no devolvió ids de imagen. Revisa el nodo de subida.');\n\nconst body = {\n  type: 'now',\n  date: DateTime.now().toUTC().toISO(),\n  shortLink: false,\n  tags: [],\n  posts: [{\n    integration: { id: cfg.postizIntegrationId },\n    value: [{ content: post.caption, image: imagenes }],\n    group: post.id,\n    settings: {}\n  }]\n};\nreturn [{ json: { body, post, totalImagenes: imagenes.length } }];"
      },
      "id": "construir-payload-de-postiz",
      "name": "Construir payload de Postiz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4160,
        120
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ $('Configuracion').first().json.postizUrl }}/public/v1/posts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "postiz-publicar-post",
      "name": "Postiz: publicar post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4380,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_POSTIZ",
          "name": "Postiz API"
        }
      }
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 3,
        "unit": "minutes"
      },
      "id": "esperar-publicacion-en-instagram",
      "name": "Esperar publicacion en Instagram",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        4600,
        120
      ],
      "webhookId": "espera-publicacion",
      "notes": "Postiz encola el envío; Instagram tarda en exponer el medio en el feed."
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "=https://graph.facebook.com/{{ $('Configuracion').first().json.metaVersion }}/{{ $('Configuracion').first().json.igUserId }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,caption,timestamp,media_type"
            },
            {
              "name": "limit",
              "value": "5"
            }
          ]
        },
        "options": {}
      },
      "id": "meta-leer-medios-recientes",
      "name": "Meta: leer medios recientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4820,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_META",
          "name": "Meta Graph API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Postiz no devuelve el media id de Instagram, así que hay que localizarlo\n// en el feed: el post recién creado debe ser reciente y empezar igual que\n// el caption que acabamos de mandar.\nconst cfg   = $('Configuracion').first().json;\nconst prep  = $('Construir payload de Postiz').first().json;\nconst post  = prep.post;\n\nconst media = ($input.first().json.data) || [];\nconst normaliza = (s) => (s || '').replace(/\\s+/g, ' ').trim().toLowerCase();\nconst inicioCaption = normaliza(post.caption).slice(0, 60);\n\nconst limite = DateTime.now().minus({ minutes: 30 });\nconst candidato = media.find(m => {\n  const reciente = m.timestamp ? DateTime.fromISO(m.timestamp) > limite : false;\n  return reciente && normaliza(m.caption).startsWith(inicioCaption);\n});\n\nif (!candidato) {\n  return [{ json: { encontrado: false, post, totalImagenes: prep.totalImagenes,\n                    detalle: 'No se encontró en el feed de @promptio_ ningún medio reciente cuyo caption coincida. ' +\n                             'El post puede seguir en cola en Postiz.' } }];\n}\nreturn [{ json: { encontrado: true, mediaId: candidato.id, post, totalImagenes: prep.totalImagenes } }];"
      },
      "id": "emparejar-post-publicado",
      "name": "Emparejar post publicado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5040,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "enc",
              "leftValue": "={{ $json.encontrado }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "comentario-localizable",
      "name": "Comentario localizable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        5260,
        120
      ]
    },
    {
