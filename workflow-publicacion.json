      "id": "github-leer-guion-de-la-semana",
      "name": "GitHub: leer guion de la semana",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        400
      ],
      "credentials": {
        "githubApi": {
          "id": "REEMPLAZAR_GITHUB",
          "name": "GitHub PROMPTIO"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Saca del guion los campos de autofill, el caption y el comentario funcional.\nconst cfg  = $('Configuracion').first().json;\nconst post = $('Seleccionar post de hoy').first().json;\nconst md   = $('GitHub: leer guion de la semana').first().json.data || '';\n\nconst bloque = (md.split(/^## /m).slice(1).find(b => b.includes(post.id))) || '';\n\nfunction campo(nombre) {\n  // [ \\t]* y no \\s*: \\s* se come los saltos de línea de forma codiciosa y no\n  // los devuelve, así que un campo vacío capturaría la cabecera siguiente.\n  const re = new RegExp('\\\\*\\\\*' + nombre + ':\\\\*\\\\*[ \\\\t]*([\\\\s\\\\S]*?)(?=\\\\n\\\\s*\\\\*\\\\*[^*]+:\\\\*\\\\*|\\\\n---|$)');\n  const m = bloque.match(re);\n  const v = m ? m[1].trim() : '';\n  return /^\\*\\*[^*]+:\\*\\*$/.test(v) ? '' : v;\n}\n\nconst titulo     = campo('Título \\\\(autofill\\\\)');\nconst cita       = campo('Cita \\\\(autofill\\\\)');\nconst desarrollo = campo('Desarrollo \\\\(autofill\\\\)');\nconst caption    = campo('Caption');\nconst comentario = campo('Comentario funcional');\n\n// El renderizador local decide el troceado; aquí solo se comprueba que el\n// guion trae con qué trabajar.\nreturn [{ json: { ...post, titulo, cita, desarrollo, caption, comentario,\n                  modoRender: cfg.renderizadorModo || 'campos',\n                  guionEncontrado: bloque.length > 0 } }];"
      },
      "id": "extraer-datos-del-guion",
      "name": "Extraer datos del guion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Puerta de entrada: sin estos datos no se arranca el pipeline.\nconst d = $input.first().json;\nconst faltantes = [];\n\nif (!d.guionEncontrado) faltantes.push('Bloque de guion con el id ' + d.id + ' en guiones/semana-' + d.semana + '.md');\nif (!d.titulo)          faltantes.push('Campo **Título (autofill):** en el guion');\nif (!d.cita)            faltantes.push('Campo **Cita (autofill):** en el guion');\nif (!d.desarrollo)      faltantes.push('Campo **Desarrollo (autofill):** en el guion');\nif (!d.caption)         faltantes.push('Campo **Caption:** en el guion');\nif (!d.comentario)      faltantes.push('Campo **Comentario funcional:** en el guion');\n\nreturn [{ json: { ...d, faltantes, listo: faltantes.length === 0 } }];"
      },
      "id": "verificar-datos-del-guion",
      "name": "Verificar datos del guion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        400
      ]
    },
