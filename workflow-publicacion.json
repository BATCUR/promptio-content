    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "url": "=https://api.github.com/repos/{{ $('Configuracion').first().json.owner }}/{{ $('Configuracion').first().json.repo }}/contents/log.md",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ref",
              "value": "={{ $('Configuracion').first().json.branch }}"
            }
          ]
        },
        "options": {}
      },
      "id": "github-leer-log.md",
      "name": "GitHub: leer log.md",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        500
      ],
      "credentials": {
        "githubApi": {
          "id": "REEMPLAZAR_GITHUB",
          "name": "GitHub PROMPTIO"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "notes": "404 en la primera ejecución es esperado."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Post del calendario cuya fecha es hoy y que no está ya en log.md.\nconst cfg = $('Configuracion').first().json;\nconst md  = $('GitHub: leer calendario.md').first().json.data || '';\n\nlet logContenido = '', logSha = '';\ntry {\n  const log = $('GitHub: leer log.md').first().json;\n  if (log && log.content) {\n    logContenido = Buffer.from(log.content, 'base64').toString('utf8');\n    logSha = log.sha || '';\n  }\n} catch (e) { /* primera ejecución */ }\n\nconst hoy = DateTime.now().setZone(cfg.zonaHoraria).toFormat('yyyy-MM-dd');\nconst RE = /^- \\*\\*(.+?)\\*\\* · \\*(.+?)\\* · `([a-z0-9]+)` · `(\\d{4}-\\d{2}-\\d{2}) (\\d{2}:\\d{2})`/;\n\nconst posts = [];\nfor (const linea of md.split('\\n')) {\n  const m = linea.match(RE);\n  if (m) posts.push({ titulo: m[1], formato: m[2], id: m[3], fecha: m[4], hora: m[5] });\n}\nif (posts.length === 0) throw new Error('No se pudo parsear ningún post de calendario.md. ¿Cambió el formato?');\n\n// Solo la primera celda de filas de tabla reales. Buscar \"| id |\" suelto por\n// todo el texto da falsos positivos con la prosa del propio log.md, y un post\n// mencionado en un comentario no se publicaría jamás.\nconst idsEnLog = new Set(\n  logContenido.split('\\n')\n    .map(l => l.match(/^\\|\\s*([a-z0-9]+)\\s*\\|/))\n    .filter(Boolean)\n    .map(m => m[1])\n);\nconst yaHecho = (id) => idsEnLog.has(id);\nconst pendientes = posts.filter(p => p.fecha === hoy && !yaHecho(p.id));\nif (pendientes.length === 0) return [];\n\nconst p = pendientes[0];\nreturn [{ json: { ...p, semana: Number(p.id.match(/^s(\\d+)/)[1]), logSha, logContenido } }];"
      },
      "id": "seleccionar-post-de-hoy",
      "name": "Seleccionar post de hoy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "url": "=https://api.github.com/repos/{{ $('Configuracion').first().json.owner }}/{{ $('Configuracion').first().json.repo }}/contents/guiones/semana-{{ $json.semana }}.md",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ref",
              "value": "={{ $('Configuracion').first().json.branch }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            }
